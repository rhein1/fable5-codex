{
  "hooks": {
    "PreCompact": [{ "matcher": "^(manual|auto)$", "hooks": [{
      "type": "command",
      "command": "node \"${PLUGIN_ROOT}/bin/codex-context-keeper.mjs\" hook",
      "commandWindows": "node \"$env:PLUGIN_ROOT/bin/codex-context-keeper.mjs\" hook",
      "timeout": 10
    }] }],
    "SessionStart": [{ "matcher": "^(startup|compact|resume)$", "hooks": [{
      "type": "command",
      "command": "node \"${PLUGIN_ROOT}/bin/codex-context-keeper.mjs\" hook",
      "commandWindows": "node \"$env:PLUGIN_ROOT/bin/codex-context-keeper.mjs\" hook",
      "timeout": 10,
      "additionalContextLimit": 512
    }] }]
  }
}
