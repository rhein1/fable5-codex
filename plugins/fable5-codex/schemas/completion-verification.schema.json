{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rhein1/fable5-codex/schemas/completion-verification-v1",
  "title": "Fable completion verification snapshot (structure, not authentication)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version","mode","taskRef","identity","generatedAt","overall","requirements","evidence","requirementsUnavailable","authorityGranted","semanticCorrectnessProved","independentEvidenceAuthentication","coverage","gaps"],
  "properties": {
    "version": {"const":"fable-completion-verification/1"},
    "mode": {"enum":["quick","deep"]},
    "taskRef": {"$ref":"#/$defs/text"},
    "identity": {"$ref":"#/$defs/identity"},
    "generatedAt": {"type":"string","format":"date-time"},
    "overall": {"$ref":"#/$defs/status"},
    "requirements": {"type":"array","maxItems":128,"items":{"$ref":"#/$defs/requirement"}},
    "evidence": {"type":"array","maxItems":128,"items":{"$ref":"#/$defs/evidence"}},
    "requirementsUnavailable": {"type":"boolean"},
    "authorityGranted": {"const":false},
    "semanticCorrectnessProved": {"const":false},
    "independentEvidenceAuthentication": {"const":false},
    "coverage": {"$ref":"#/$defs/text"},
    "gaps": {"type":"array","maxItems":128,"items":{"$ref":"#/$defs/text"}}
  },
  "$defs": {
    "id": {"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_-]{0,63}$"},
    "text": {"type":"string","minLength":1,"maxLength":2048},
    "sha": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "revision": {"anyOf":[{"$ref":"#/$defs/sha"},{"type":"null"}]},
    "status": {"enum":["verified","incomplete","unverified"]},
    "method": {"enum":["source","local","mock","hosted","installed","deployed","production"]},
    "identity": {
      "type":"object","additionalProperties":false,
      "required":["repository","rootDigest","head","prHead","base","mergeTest","snapshotDigest","dirty","scope","fileCount","repositoryProvenance","referenceProvenance"],
      "properties": {
        "repository":{"type":"string","minLength":1,"maxLength":256},
        "rootDigest":{"$ref":"#/$defs/digest"},"head":{"$ref":"#/$defs/sha"},
        "prHead":{"$ref":"#/$defs/revision"},"base":{"$ref":"#/$defs/revision"},"mergeTest":{"$ref":"#/$defs/revision"},
        "snapshotDigest":{"$ref":"#/$defs/digest"},"dirty":{"type":"boolean"},
        "scope":{"const":"tracked_and_nonignored_untracked"},"fileCount":{"type":"integer","minimum":0,"maximum":1024},
        "repositoryProvenance":{"const":"caller_label_and_observed_root"},"referenceProvenance":{"const":"local_object_availability_only"}
      }
    },
    "requirement": {
      "type":"object","additionalProperties":false,
      "required":["id","text","origin","sourceRef","methods","status","reason","evidenceIds","changes","remainingWork","nextAction","semanticJudgment"],
      "properties": {
        "id":{"$ref":"#/$defs/id"},"text":{"$ref":"#/$defs/text"},"origin":{"enum":["explicit","assumption"]},
        "sourceRef":{"$ref":"#/$defs/text"},"methods":{"type":"array","minItems":1,"maxItems":7,"uniqueItems":true,"items":{"$ref":"#/$defs/method"}},
        "hostedChecks":{"type":"array","maxItems":32,"items":{"type":"object","additionalProperties":false,"required":["name","appId"],"properties":{"name":{"$ref":"#/$defs/text"},"appId":{"type":"integer","minimum":1}}}},
        "status":{"$ref":"#/$defs/status"},"reason":{"type":"string","minLength":1,"maxLength":2304},
        "evidenceIds":{"type":"array","maxItems":128,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
        "changes":{"type":"array","maxItems":128,"items":{"$ref":"#/$defs/text"}},
        "remainingWork":{"$ref":"#/$defs/text"},"nextAction":{"$ref":"#/$defs/text"},
        "semanticJudgment":{"enum":["coordinator_reasoned_not_machine_proved","unavailable"]}
      }
    },
    "evidence": {
      "type":"object","additionalProperties":false,
      "required":["id","method","outcome","provenance","ref","context","binding"],
      "properties": {
        "id":{"$ref":"#/$defs/id"},"method":{"$ref":"#/$defs/method"},
        "outcome":{"enum":["passed","failed","skipped","cancelled","pending","unavailable"]},
        "provenance":{"enum":["host_observed","supplied_unverified"]},
        "ref":{"$ref":"#/$defs/text"},"context":{"type":"object"},"binding":{"$ref":"#/$defs/identity"}
      }
    }
  }
}
